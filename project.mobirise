        "dangerColor": "#1eff00",
        "mainFont": "Rubik",
        "display1Font": "Poppins",
        "display1Size": 4.25,
        "display2Font": "Poppins",
        "display2Size": 3,
        "display5Font": "Poppins",
        "display5Size": 1.5,
        "display7Font": "Poppins",
        "display7Size": 1,
        "display4Font": "Poppins",
        "display4Size": 1,
        "isRoundedButtons": true,
        "isAnimatedOnScroll": false,
        "isScrollToTopButton": false
      },
      "additionalSetColors": [
        "#1eff00",
        "#009b37",
        "#319b42",
        "#09e52d"
      ]
    },
    "path": "@PROJECT_PATH@",
    "versionFirst": "5.0.11",
    "siteFonts": [
      {
